{
  "name": "gazette-next-example",
  "private": true,
  "version": "0.0.0",
  "description": "Minimal Next.js (App Router, React 18) host embedding a built gazette document.",
  "scripts": {
    "gazette": "node ../../bin/gazette.js build ../basic/paper.md --target next --base-path /gazette --out ./public",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000"
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0"
  }
}
