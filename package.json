{
  "name": "gazette",
  "version": "0.1.0",
  "description": "Compile a single Markdown source into a self-contained, interactive scientific document.",
  "type": "module",
  "bin": {
    "gazette": "./bin/gazette.js"
  },
  "files": [
    "bin",
    "src",
    "runtime",
    "assets",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "example": "node bin/gazette.js build examples/basic/paper.md --target static"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "hast-util-to-string": "^3.0.1",
    "js-yaml": "^4.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^3.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sirv": "^3.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3"
  },
  "optionalDependencies": {
    "puppeteer": "^23.11.1"
  }
}
